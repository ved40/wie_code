<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container mt-5">
        <h1 class="mb-4 fw-bold">Admin Dashboard</h1>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card text-bg-primary shadow">
                    <div class="card-body">
                        <h4>Total Registered Patients
                            <%= patientcount%>
                        </h4>
                        <h2>

                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card text-bg-success shadow">
                    <div class="card-body">
                        <h4>Total Doctors</h4>
                        <h2>

                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <h3 class="mt-4">All Patients</h3>
        <table class="table table-bordered table-hover mt-2">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Gender</th>
                    <th>DOB</th>
                </tr>
            </thead>
            <tbody>
                <% for(patient of patients){ %>
                    <tr>
                        <td>
                            <%= patient.name %>
                        </td>
                        <td>
                            <%= patient.gender %>
                        </td>
                        <td>
                            <%= new Date(patient.dob).toLocaleDateString("en-IN", { day: "2-digit" , month: "short" ,
                                year: "numeric" }) %>
                        </td>

                    </tr>
                    <% }%>
            </tbody>
        </table>
    </div>

</body>

</html>