<!DOCTYPE html>
<html>

<head>
    <title>Doctor Added Successfully</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-success text-white text-center">
                        <h2 class="mb-0">✓ Success!</h2>
                    </div>
                    <div class="card-body text-center">
                        <h4 class="mb-4">Doctor has been added successfully!</h4>
                        <p class="text-muted mb-4">Redirecting to admin dashboard...</p>
                        <a href="javascript:history.back()" class="btn btn-success btn-lg">Go Back to Admin
                            Dashboard</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Redirect back after 2 seconds
        setTimeout(() => {
            history.back();
        }, 2000);
    </script>

</body>

</html>