<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Dashboard - HealthEase</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="doctor_dashboard.css">
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <i class="bi bi-stethoscope"></i> CLINIC-CONNECT
        </div>

        <a onclick="showSection('home')"><i class="bi bi-house-heart"></i> Dashboard</a>
        <a onclick="showSection('appointments')"><i class="bi bi-calendar2-check"></i> My Appointments</a>
        <a onclick="showSection('patients')"><i class="bi bi-people"></i> Patient List</a>
        <a onclick="showSection('prescriptions')"><i class="bi bi-file-medical"></i> Prescriptions</a>

        <a href="/" class="logout"><i class="bi bi-box-arrow-left"></i> Logout</a>
    </div>

    <!-- Content -->
    <div class="content">

        <!-- Home Section -->
        <div id="home">
            <h1 class="fw-bold">Welcome Doctor 👨‍⚕️</h1>
            <p>Here’s a quick overview of your schedule and patient activity.</p>

            <div class="row mt-4">

                <div class="col-md-4">
                    <div class="card shadow p-4 text-center">
                        <i class="bi bi-calendar2-check fs-1 text-primary"></i>
                        <h4 class="mt-3">Today's Appointments</h4>
                        <p class="fs-4 fw-bold text-success">12</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-4 text-center">
                        <i class="bi bi-people fs-1 text-warning"></i>
                        <h4 class="mt-3">Total Patients</h4>
                        <p class="fs-4 fw-bold text-success">48</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-4 text-center">
                        <i class="bi bi-file-earmark-medical fs-1 text-danger"></i>
                        <h4 class="mt-3">Pending Reports</h4>
                        <p class="fs-4 fw-bold text-success">7</p>
                    </div>
                </div>

            </div>
        </div>

        <!-- Appointments Section -->
        <div id="appointments" class="d-none">
            <h2><i class="bi bi-calendar-check"></i> Appointments</h2>
            <p>Upcoming and ongoing consultation schedule will appear here.</p>

            <table class="table table-striped mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Patient Name</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>Date and time</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(appointment of appointments){ %>
                        <tr>
                            <td>
                                <%=appointment.name%>
                            </td>
                            <td>
                                <%=appointment.gender%>
                            </td>
                            <td>
                                <%= new Date(appointment.dob).toLocaleDateString("en-IN", { day: "2-digit" ,
                                    month: "short" , year: "numeric" }) %>
                            </td>
                            <td>
                                <%= new Date(appointment.appointmentDateTime).toLocaleString("en-IN", { day: "2-digit" ,
                                    month: "short" , year: "numeric" , hour: "2-digit" , minute: "2-digit" }) %>
                            </td>
                            <% } %>
                        </tr>
                </tbody>
            </table>
        </div>

        <!-- Patient List -->
        <div id="patients" class="d-none">
            <h2><i class="bi bi-people"></i> Patient List</h2>
            <p>Access medical records, history, reports.</p>

            <input class="form-control w-50 my-3" placeholder="Search Patient...">

            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Last Visit</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Aakash Patil</td>
                        <td>25</td>
                        <td>2025-11-20</td>
                        <td><button class="btn btn-outline-info btn-sm">View Record</button></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Prescription Section -->
        <div id="prescriptions" class="d-none">
            <h2><i class="bi bi-file-medical"></i> Prescriptions</h2>
            <p>Manage or create digital prescriptions for patients.</p>

            <button class="btn btn-primary my-3"><i class="bi bi-plus-lg"></i> Create New Prescription</button>
        </div>

    </div>


    <script>
        function showSection(sectionId) {
            document.querySelectorAll(".content > div").forEach(sec => sec.classList.add("d-none"));
            document.getElementById(sectionId).classList.remove("d-none");
        }
    </script>

</body>

</html>