<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CLINIC-CONNECT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="home.css">
</head>

<body>

    <!-- Header -->
    <header class="hero-section text-center text-white d-flex align-items-center justify-content-center flex-column">
        <h1 class="display-4 fw-bold">Welcome to <span class="highlight">CLINIC-CONNECT</span></h1>
        <p class="lead">Smart Patient Management System</p>
        <p>A streamlined healthcare management system for patients and professionals.</p>
        <a class="btn btn-light btn-lg px-4 mt-3" href="/user_type">Login to Continue</a>
    </header>

    <!-- Feature Cards -->
    <div class="container mt-5">
        <div class="row justify-content-center g-4">

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h5 class="card-title mt-3">Patient Registration</h5>
                    <p class="card-text">Register patients and securely store demographic and medical information.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h5 class="card-title mt-3">Appointment Management</h5>
                    <p class="card-text">Schedule and manage appointments with real-time availability tracking.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h5 class="card-title mt-3">Patient History</h5>
                    <p class="card-text">Access previous consultations, treatments, diagnoses, and prescriptions.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-file-medical"></i>
                    </div>
                    <h5 class="card-title mt-3">Digital Prescriptions</h5>
                    <p class="card-text">Generate secure e-prescriptions with dosage and instructions.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card feature-card p-4 text-center">
                    <div class="icon-circle">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                    <h5 class="card-title mt-3">Medical Reports</h5>
                    <p class="card-text">Upload and store lab reports and diagnostic documents digitally.</p>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>