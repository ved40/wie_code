<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Dashboard - CLINIC-CONNECT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/patient_dashboard.css">
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo text-light">
            <i class="bi bi-heart-pulse-fill"></i> CLINIC-CONNECT
        </div>

        <a onclick="showSection('home')"><i class="bi bi-house-heart"></i> Dashboard</a>
        <a onclick="showSection('profile')"><i class="bi bi-person-circle"></i> My Profile</a>
        <a onclick="showSection('appointments')"><i class="bi bi-calendar-week"></i> Appointments</a>
        <a onclick="showSection('prescriptions')"><i class="bi bi-capsule"></i> Prescriptions</a>
        <a onclick="showSection('history')"><i class="bi bi-journal-medical"></i> Medical History</a>

        <a href="/" class="logout"><i class="bi bi-box-arrow-left"></i> Logout</a>
    </div>

    <!-- Content -->
    <div class="content">

        <!-- Home / Overview -->
        <div id="home">
            <h1 class="fw-bold">Welcome, <%= user.name %> 👋</h1>
            <p>Your health records are securely stored with us.</p>

            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card shadow p-4 text-center">
                        <i class="bi bi-calendar-check-fill fs-1 text-primary"></i>
                        <h4 class="mt-3">Upcoming Appointments</h4>
                        <p class="fs-4 fw-bold text-success">

                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow p-4 text-center">
                        <i class="bi bi-capsule-pill fs-1 text-danger"></i>
                        <h4 class="mt-3">Prescriptions</h4>
                        <p class="fs-4 fw-bold text-success">

                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile -->
        <div id="profile" class="d-none">
            <h2><i class="bi bi-person-badge"></i> My Profile</h2>

            <div class="card shadow p-4 mt-3" style="max-width: 600px;">
                <p><strong>Name:</strong>
                    <%= user.name %>
                </p>
                <p><strong>Email:</strong>
                    <%= user.email %>
                </p>
                <p><strong>Phone:</strong>
                    <%= user.phone %>
                </p>
                <p><strong>DOB:</strong>
                    <%= user.dob %>
                </p>
                <p><strong>Gender:</strong>
                    <%= user.gender %>
                </p>
                <p><strong>Address:</strong>
                    <%= user.address %>
                </p>
            </div>
        </div>

        <!-- Appointments -->
        <div id="appointments" class="d-none">
            <h2><i class="bi bi-calendar-week"></i> My Appointments</h2>
            <p>View your upcoming and past appointments.</p>

            <div class="card shadow p-4 mt-3">
                <table class="table table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Patient Name</th>
                            <th>Gender</th>
                            <th>DOB</th>
                            <th>Date and time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(appointment of appointments){ %>
                            <tr>
                                <td>
                                    <%=appointment.name%>
                                </td>
                                <td>
                                    <%=appointment.gender%>
                                </td>
                                <td>
                                    <%= new Date(appointment.dob).toLocaleDateString("en-IN", { day: "2-digit" ,
                                        month: "short" , year: "numeric" }) %>
                                </td>
                                <td>
                                    <%= new Date(appointment.appointmentDateTime).toLocaleString("en-IN", {
                                        day: "2-digit" , month: "short" , year: "numeric" , hour: "2-digit" ,
                                        minute: "2-digit" }) %>
                                </td>
                            </tr>
                            <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Prescriptions -->
        <div id="prescriptions" class="d-none">
            <h2><i class="bi bi-capsule"></i> My Prescriptions</h2>
            <p>View all prescriptions prescribed by your doctors.</p>

            <div class="card shadow p-4 mt-3">
                <table class="table table-striped" id="prescriptionTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Doctor Name</th>
                            <th>Date</th>
                            <th>Medicines</th>
                            <th>Expiry Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="prescriptionList">
                        <tr>
                            <td colspan="5" class="text-center text-muted">Loading prescriptions...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div id="history" class="d-none">
            <h2><i class="bi bi-journal-medical"></i> Medical History</h2>
            <p>📄 Feature coming soon...</p>
        </div>

    </div>

    <script>
        function showSection(id) {
            document.querySelectorAll(".content > div").forEach(div => div.classList.add("d-none"));
            document.getElementById(id).classList.remove("d-none");

            // Load prescriptions when prescriptions section is opened
            if (id === "prescriptions") {
                loadPrescriptions();
            }
        }

        // Load patient prescriptions
        async function loadPrescriptions() {
            const patientEmail = "<%= user.email %>";

            try {
                const response = await fetch(`/get_prescriptions/${patientEmail}`);
                const prescriptions = await response.json();

                const prescriptionList = document.getElementById("prescriptionList");

                if (prescriptions.length === 0) {
                    prescriptionList.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No prescriptions available</td></tr>';
                    return;
                }

                prescriptionList.innerHTML = prescriptions.map(rx => `
                    <tr>
                        <td>${rx.doctorName}</td>
                        <td>${new Date(rx.date).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" })}</td>
                        <td>
                            <small>${rx.medicines.substring(0, 50)}${rx.medicines.length > 50 ? '...' : ''}</small>
                        </td>
                        <td>
                            ${rx.expiryDate ? new Date(rx.expiryDate).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }) : 'N/A'}
                        </td>
                        <td>
                            <a href="${rx.prescriptionFile}" target="_blank" class="btn btn-sm btn-primary">
                                <i class="bi bi-download"></i> View
                            </a>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                document.getElementById("prescriptionList").innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading prescriptions</td></tr>';
                console.error("Error:", error);
            }
        }

        // Show home section by default on page load
        window.addEventListener('load', () => {
            showSection('home');
        });
    </script>

</body>

</html>