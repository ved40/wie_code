<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="user_type.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg shadow-sm px-4 d-flex align-items-center" id="mainNavbar">

        <!-- Back Button -->
        <button onclick="history.back()" class="btn btn-outline-secondary me-3 back-btn">
            <i class="bi bi-arrow-left"></i>
        </button>

        <!-- Logo + Name -->
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <i class="bi bi-hospital-fill text-primary fs-3"></i>
            <span class="logo-text">CLINIC-CONNECT</span>
        </a>
    </nav>

    <!-- Admin Button -->
    <a href="/admin_login" class="btn btn-primary admin-btn">
        <i class="bi bi-gear-fill"></i> Hospital Admin
    </a>



    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="text-center">
            <h2 class="mb-4">Choose Login</h2>

            <div class="row g-4">

                <div class="col-md-12">
                    <div class="role-card" onclick="window.location.href='/doctor_login'">
                        <i class="bi bi-heart-pulse display-5"></i>
                        <h5 class="mt-2">Doctor</h5>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="role-card" onclick="window.location.href='/receptionist_login'">
                        <i class="bi bi-person-badge display-5"></i>
                        <h5 class="mt-2">Receptionist</h5>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="role-card" onclick="window.location.href='/patient_login'">
                        <i class="bi bi-people display-5"></i>
                        <h5 class="mt-2">Patient</h5>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>

</html>